# Feed ingestion keys: used to pull new threat data into SENTINEL.
OTX_API_KEY=CHANGEME
THREATFOX_API_KEY=CHANGEME
MALWAREBAZAAR_API_KEY=CHANGEME
PHISHTANK_APP_KEY=

# Enrichment keys: used after ingestion to validate, enrich, and score IOCs.
VT_API_KEY=CHANGEME
SHODAN_API_KEY=CHANGEME
ABUSEIPDB_API_KEY=CHANGEME
# Optional runtime tuning is configured in config.yaml:
# enrichment.provider_timeout_seconds / batch_size / max_iocs_per_run
# sources.mix.max_items_per_source limits single-feed dominance during scraping.
# karpathy.* controls live loop promotion thresholds and service lease timing.

# Delivery / external integrations.
TELEGRAM_BOT_TOKEN=CHANGEME
TELEGRAM_CHAT_ID=CHANGEME
# Primary production commands:
# 1. Scheduled ingest/delivery: env PYTHONPATH=. .venv/bin/python -m sentinel.cli cron-run
# 2. Always-on feedback/learner: env PYTHONPATH=. .venv/bin/python -m sentinel.cli feedback-service
# Legacy split commands remain available for debugging:
#    sentinel.cli telegram-listen / sentinel.cli karpathy-service
SENDGRID_API_KEY=CHANGEME
CS_CLIENT_ID=CHANGEME
CS_CLIENT_SECRET=CHANGEME

# LLM / runtime configuration.
ANTHROPIC_API_KEY=CHANGEME
OPENAI_API_KEY=CHANGEME
OPENAI_BASE_URL=https://api.openai.com/v1
MITRE_STIX_PATH=CHANGEME
DATABASE_URL=sqlite+aiosqlite:///./data/sentinel.db
REDIS_URL=disabled
